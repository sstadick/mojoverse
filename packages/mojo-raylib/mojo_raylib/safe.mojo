    var count: c_int = 0
    var _owned = raw.ExportImageToMemory(public_types._to_raw_image(image), CStringSpan(unsafe_from_ptr=file_type.unsafe_ptr().unsafe_bitcast[c_char]()), Pointer(to=count))
    return OwnedExportImageToMemory(_owned, Int(count))

