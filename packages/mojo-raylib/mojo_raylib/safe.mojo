@always_inline
def compress_data(data: Span[mut=False, UInt8, _]) -> OwnedCompressData:
    """Compress data (DEFLATE algorithm), memory must be MemFree().

    Args:
        data: The data.

    Returns:
        An owning result that releases its raylib allocation automatically.
    """
    var count: c_int = 0
    var _owned = raw.CompressData(data.unsafe_ptr().unsafe_bitcast[c_uchar](), c_int(len(data)), Pointer(to=count))
    return OwnedCompressData(_owned, Int(count))

