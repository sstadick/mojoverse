    Args:
        text: The text.
        delimiter: The delimiter.

    Returns:
        The resulting value.
    """
    var count: c_int = 0
    var result = raw.TextSplit(CStringSpan(unsafe_from_ptr=text.unsafe_ptr().unsafe_bitcast[c_char]()), c_char(delimiter), Pointer(to=count))
    return result

@always_inline
def text_append(text: Pointer[mut=True, c_char, _], append: String):
