{
  "name": "mojo-lsp-bridge",
  "displayName": "Mojo LSP Bridge",
  "description": "Mojo language support with matching stdlib sources, import quick fixes, and crash recovery.",
  "version": "0.1.0",
  "publisher": "sstadick",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sstadick/mojo-lsp-bridge.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The bridge runs Python and the Mojo compiler installed in your project."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "node build.js",
    "package": "vsce package --no-dependencies",
    "test": "node --test test/discovery.test.js",
    "test:integration": "node build.js && node test/run.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "mojo",
        "aliases": [
          "Mojo",
          "mojo"
        ],
        "extensions": [
          ".mojo",
          ".🔥"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "mojoBridge.restart",
        "title": "Mojo LSP Bridge: Restart Language Servers"
      }
    ],
    "configuration": {
      "title": "Mojo LSP Bridge",
      "properties": {
        "mojoBridge.serverPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute path to mojo-lsp-server. Empty discovers .pixi/envs/default or .venv in the workspace folder and its ancestors, then PATH."
        },
        "mojoBridge.pythonPath": {
          "type": "string",
          "default": "python3",
          "scope": "resource",
          "description": "Python 3.10+ executable on the development machine (remote host for SSH/WSL/containers)."
        },
        "mojoBridge.options": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Bridge initialization options: stdlib_path, download_stdlib, import_paths, and restart_limit. Relative paths resolve against the workspace folder."
        }
      }
    },
    "configurationDefaults": {
      "[mojo]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2"
  }
}
